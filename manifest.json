{
  "manifest_version": 3,
  "name": "Tab Analytics",
  "version": "2.0.0",
  "description": "Real-time tab analytics and visual insights for efficient tab management",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}